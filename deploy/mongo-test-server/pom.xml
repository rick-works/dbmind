<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dbmind</groupId>
  <artifactId>dbmind-mongo-test-server</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>DBMind MongoDB test server</name>
  <description>
    可复现的 Mongo 服务（mongo-java-server：用 Java 实现的 Mongo 线协议服务端）。
    只用于本地验证与 CI —— 不需要装 MongoDB，也不会污染真实数据。
    这是 roadmap 里「真实库测试场」的第一块：验证协议宿主必须有真库可连，
    而「让每个开发者先装一个 MongoDB」不是可持续的做法。
  </description>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.bwaldvogel</groupId>
      <artifactId>mongo-java-server</artifactId>
      <!-- 越新越好：新版会汇报更高的 wire version，才能被现代驱动接受 -->
      <version>1.47.0</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>dbmind-mongo-test-server</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.dbmind.deploy.MongoTestServer</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
