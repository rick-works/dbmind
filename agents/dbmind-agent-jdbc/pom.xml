<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.dbmind</groupId>
  <artifactId>dbmind-agent-jdbc</artifactId>
  <version>0.1.0</version>
  <packaging>jar</packaging>
  <name>DBmind JDBC Agent</name>
  <description>
    通用 JDBC 驱动宿主：只做「加载驱动类 + 按内核给的 URL 连接 + 执行 + 映射结果」四件事。
    所有「怎么连某个数据库」的知识都在 plugins/connection-types/*.yaml 里，
    因此新增数据库类型不需要重新构建本进程。
  </description>

  <properties>
    <!--
      必须编译到 17：源码用了 `instanceof` 模式匹配（Java 16+，见 DriverLoader / ResultMapper）
      与 `switch` 表达式（Java 14+，见 Main）。往下降会直接编译不过。
      所以「宿主要求的 Java 版本」这件事不能靠降目标来消掉，只能由运行时的就绪判断来把关：
      内核按 `AgentHostSpec::min_java` 校验当前 JVM 版本（见 dbmind-core/src/agent.rs）。
      改了这里的版本，记得同步那个常量。
    -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- 唯一的第三方依赖：JSON。协议是窄的，不值得为它引入更多东西 -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>2.11.0</version>
    </dependency>
    <!--
      JVM 自定义解析器（消除 MySQL 驱动建连时 ~4.6s 的 IP 反解等待）。
      这个模块编译到 18（SPI 是 @since 18），shade 只把它的 **class** 合并进本 fat jar
      （不含 SPI 服务声明文件 —— 那份文件由内核在运行时按 JDK 版本写到
      jar 旁的 resolver-svc/ 目录，JDK 17 上不写、provider 类永远不被加载）。
      构建前必须先 mvn install agents/dbmind-host-resolver。
    -->
    <dependency>
      <groupId>com.dbmind</groupId>
      <artifactId>dbmind-host-resolver</artifactId>
      <version>0.1.0</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <!-- 产物名与内核里的 AGENT_JAR_NAME 常量一致 -->
    <finalName>dbmind-agent-jdbc</finalName>
    <plugins>
      <!-- compiler 插件 3.1（Maven 内置默认）不认识 maven.compiler.release 属性，
           会退回 source 1.5 直接编译失败 —— 显式钉到认识 release 的版本 -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.dbmind.agent.Main</mainClass>
                  <!--
                    SPI 服务声明目录（-jar 模式系统 classpath = 主 jar + manifest Class-Path）：
                    内核在宿主 JDK ≥ 18 时往 `<jar 所在目录>/resolver-svc/` 写
                    META-INF/services/java.net.spi.InetAddressResolverProvider，
                    ServiceLoader 才会加载 HostsResolverProvider；目录不存在 = 不启用，
                    行为与以前完全一致。相对路径相对 jar 所在目录解析。
                  -->
                  <manifestEntries>
                    <Class-Path>resolver-svc/</Class-Path>
                  </manifestEntries>
                </transformer>
              </transformers>
              <createDependencyReducedPom>false</createDependencyReducedPom>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
