{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBMind",
  "version": "0.1.0",
  "identifier": "com.dbmind.desktop",
  "build": {
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../../frontend/dist": "web",
      "../../agents/dbmind-agent-jdbc/target/dbmind-agent-jdbc.jar": "agents/dbmind-agent-jdbc.jar",
      "../../agents/dbmind-agent-mongodb/target/dbmind-agent-mongodb.jar": "agents/dbmind-agent-mongodb.jar",
      "../../agents/dbmind-agent-redis/target/dbmind-agent-redis.jar": "agents/dbmind-agent-redis.jar",
      "../../agents/dbmind-agent-elasticsearch/target/dbmind-agent-elasticsearch.jar": "agents/dbmind-agent-elasticsearch.jar"
    }
  }
}
