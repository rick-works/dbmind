# 构建产物
#
# target/ 实测 21.9 GB（Rust 增量编译），进仓库会把首次提交变成一场灾难 —— 必须排除。
/target/
**/target/

# 前端依赖与构建产物（node_modules 262 MB；dist 是构建输出，克隆后自己 build 即可）
/frontend/node_modules/
/frontend/dist/
/dist/

# 运行期产物
/logs/
*.log
go.txt

# 本地运行数据（SQLite 数据库与 WAL，不该进历史）
/dbmind.db
/dbmind.db-shm
/dbmind.db-wal
*.yaml

# 一次性工具与现场留存（排查用，不该进历史）
.export-broken.bak
.i18n-pairs*.txt
.i18n-apply.ps1

# 编辑器 / 系统
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
.playwright-cli/

# 官网源文件：只用于本地预览与手动同步到 gh-pages 分支，不进版本库
/website/
