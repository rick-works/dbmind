# 构建产物
#
# target/ 实测 21.9 GB（Rust 增量编译），进仓库会把首次提交变成一场灾难 —— 必须排除。
/target/
**/target/

# 前端依赖与构建产物（node_modules 262 MB；dist 是构建输出，克隆后自己 build 即可）
/frontend/node_modules/
/frontend/dist/
/dist/

# 运行期产物
/logs/
*.log
go.txt

# 本地运行数据（SQLite 数据库与 WAL，不该进历史）
/dbmind.db
/dbmind.db-shm
/dbmind.db-wal
*.yaml

# 一次性工具与现场留存（排查用，不该进历史）
.export-broken.bak
.i18n-pairs*.txt
.i18n-apply.ps1
_uitest/

# 编辑器 / 系统
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store
.playwright-cli/

# 官网源文件：**index.html 入库跟踪** —— 它原先只活在 gh-pages 分支里、主仓看不见，
# 于是每次发版都容易漏更新（一漏就是 8 个版本，用户反馈"官网版本内容都没更新"）。
# 入库后有 diff、能被 review。
# 发版流程见 scripts/release/publish-site.ps1，release.mjs 里还会检查"新版本的条目加了没"。
/website/*
!/website/index.html
# 页面引用的静态资源同样必须入库：GitHub Pages 现在由 Actions 直接部署 website/ 目录
#（见 .github/workflows/pages.yml），checkout 里没有的文件部署上去就是 404 ——
# 之前只放行了 images/，于是 logo.png、favicon.png、赞赏码、sponsors.js 在线上全是坏的
#（页面能打开、logo 变裂图）。
!/website/images/
!/website/logo.png
!/website/favicon.png
!/website/sponsor-wechat.png
!/website/sponsor-alipay.png
!/website/sponsors.js
!/website/.nojekyll

# 本机构建加速配置：.cargo/config.toml 里的 rust-lld 链接器路径是**每台机器各不相同**的
# 绝对路径（写死的本机路径会让 CI / 别人机器直接构建失败：linker not found）。
# 保留在各人本机即可，不入库；需要的人照 .cargo/config.toml.example 自己建一份。
.cargo/config.toml

# 签名证书与私钥：只该存在于 GitHub Actions secrets（以及本机的安全位置），绝不入库 ——
# 误提交一次就得整套换证书（Apple 与各家 CA 都会要求吊销后重签，公证 / SmartScreen 信誉清零）。
# 覆盖我们这条链路会用到的全部中间文件：.p12（导出的钥匙串）/ .pfx（Windows 证书）/
# .csr（申请文件）/ .cer（Apple 中间证书）/ .key（私钥）/ .b64（转好的 base64）。
*.p12
*.pfx
*.csr
*.cer
*.key
*.b64

# Screenshots: only web-sized versions are committed; originals (Retina 2x) stay local
docs/images/originals/
